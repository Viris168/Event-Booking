# Feeds docker-compose.yml. NOT the same file as api/.env, which feeds the
# Spring Boot app - the two overlap only on DB_*, and those must agree or the
# API cannot reach its own database.
#
# ⚠ A previous version of this file was COMMITTED (see commit 3a29bd6). Every
#   password that was in it is public forever; git history is not editable in
#   any way that helps once a repo has been pushed. Generate new values below
#   with:  openssl rand -base64 24
#
#   Note that POSTGRES_PASSWORD, GF_SECURITY_ADMIN_PASSWORD and
#   PGADMIN_DEFAULT_PASSWORD are read only when the container FIRST
#   initialises its volume. Changing them here does not rotate an existing
#   install - see "Rotating" at the bottom.

# ── Port binding ───────────────────────────────────────
# Loopback only. Docker's iptables rules bypass ufw/firewalld, so publishing on
# 0.0.0.0 exposes these services to the internet no matter what the host
# firewall says. Reach them remotely over an SSH tunnel instead:
#   ssh -L 53000:localhost:53000 user@server
BIND_ADDRESS=127.0.0.1

# ── Database ───────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:55432/event_booking
DB_USERNAME=postgres
DB_PASSWORD=
DB_PORT=55432

# ── pgAdmin ────────────────────────────────────────────
PGADMIN_EMAIL=admin@eventbooking.dev
PGADMIN_PASSWORD=
PGADMIN_PORT=55050

# ── Monitoring ─────────────────────────────────────────
PROMETHEUS_PORT=59090
GRAFANA_PORT=53000
GRAFANA_USER=admin
GRAFANA_PASSWORD=
LOKI_PORT=53100

# ── Logging ────────────────────────────────────────────
# Promtail mounts ./logs (relative to docker-compose.yml) at /host-logs, so this
# must resolve to THAT directory. `mvn spring-boot:run` from api/ would
# otherwise write to api/logs and Promtail would tail an empty file.
LOGGING_FILE_PATH=./logs/app.log

# ── Rotating an already-initialised stack ──────────────
# Postgres:
#   docker compose exec postgres psql -U postgres \
#     -c "ALTER USER postgres WITH PASSWORD 'new-value';"
#   then update DB_PASSWORD here AND in api/.env.
# Grafana:
#   docker compose exec grafana grafana cli admin reset-admin-password 'new-value'
# pgAdmin:
#   change it in the pgAdmin UI, or delete the volume and re-init.
