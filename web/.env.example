# Vite only exposes variables prefixed with VITE_ to the app.

VITE_API_BASE_URL=/api/v1
VITE_APP_NAME=CamboBook
VITE_DEFAULT_CURRENCY=USD

# Google sign-in. The OAuth 2.0 Web client id from Google Cloud Console.
# Must match GOOGLE_CLIENT_ID on the API - it is the audience every ID token
# is verified against. Empty hides the button entirely.
VITE_GOOGLE_CLIENT_ID=
