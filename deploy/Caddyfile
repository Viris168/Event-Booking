# Caddy gets a certificate from Let's Encrypt on first start and renews it on
# its own — there is no certbot, no cron job, and no renewal to forget. The
# only prerequisite is that DOMAIN's A/AAAA record already points at this VPS
# before the container starts, because the ACME challenge is served on :80.
{
	email {$ACME_EMAIL}
	# The admin API is left at its default, which is 127.0.0.1:2019 — the
	# CONTAINER's own loopback. No port publishes it, and a container's loopback
	# is not reachable from other containers on the network (verified), so there
	# is nothing here for the internet or a neighbouring service to talk to.
	#
	# `admin off` was the first thing tried and it is a bad trade: it buys no
	# security that the default does not already have, and it breaks
	# `caddy reload`, which is the zero-downtime way to apply a config change.
	# Without it the only way to pick up an edit is restarting the container.
	#
	# If you ever set this explicitly, never bind it to 0.0.0.0 and never add a
	# 2019 entry to `ports:` — it can rewrite every route in this file.
}

{$DOMAIN} {
	encode zstd gzip

	# ── API ──────────────────────────────────────────────────────────────
	# Only /api/* crosses the edge. /actuator is deliberately NOT routed:
	# /actuator/prometheus and /actuator/health are permitAll in SecurityConfig
	# so Prometheus can scrape them over the private network, and the way to
	# keep that from also meaning "the internet can scrape them" is to give the
	# internet no path to /actuator at all.
	handle /api/* {
		reverse_proxy api:8080 {
			# The app builds absolute URLs and logs client IPs; without these
			# every request appears to come from the Caddy container over
			# plain http.
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# ── SPA ──────────────────────────────────────────────────────────────
	handle {
		reverse_proxy web:80
	}

	header {
		# Two years, and preload-eligible. Only meaningful once the site is
		# actually serving HTTPS everywhere — which it is, since Caddy redirects
		# :80 to :443 automatically.
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# The gate-scanning page uses the camera (html5-qrcode); everything else
		# the browser could hand out, it should not.
		Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=()"
		-Server
	}

	# Access logs go to stdout, which means `docker compose logs caddy` and, if
	# the monitoring overlay is running, Loki.
	log {
		output stdout
		format json
	}
}
