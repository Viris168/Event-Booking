# Production environment for the VPS stack.
#
#   cp env.prod.example .env.prod
#   ./scripts/gen-secrets.sh          # fills the three generated secrets
#   $EDITOR .env.prod                 # fill in the rest
#
# The file is named .env.prod, not .env, so `docker compose` in this directory
# never picks it up implicitly — deploy.sh passes it with --env-file. It is
# gitignored (the root .gitignore covers .env.*); this .example, without the
# leading dot, is the tracked one.
#
# chmod 600 it. Every credential the platform has is in here.

# ── Host ───────────────────────────────────────────────────────────────────
# The DNS name pointing at this VPS. Caddy requests the certificate for exactly
# this name, so it must resolve here BEFORE the first `up` or ACME fails and
# Caddy backs off for a while before retrying.
DOMAIN=booking.example.com
# Let's Encrypt sends expiry warnings here. A real mailbox you read.
ACME_EMAIL=you@example.com

# ── Database ───────────────────────────────────────────────────────────────
# Read by both the postgres container (as POSTGRES_*) and the API. Postgres
# applies the password on FIRST initialisation only — changing it here later
# does not change the role's password, it just breaks the connection. See
# "Rotating the database password" in README.md.
DB_NAME=event_booking
DB_USERNAME=eventbooking
# Generated by scripts/gen-secrets.sh. Note there is no trailing comment on
# this line, or any value line in this file: an env_file is not a shell, and a
# `KEY=value  # note` is a value with a note in it.
DB_PASSWORD=
# DB_URL is set in docker-compose.prod.yml (jdbc:postgresql://postgres:5432/...)
# and must not be set here — the host is a container name on a private network,
# never localhost:55432, which is a development-only publication.

# ── JPA ────────────────────────────────────────────────────────────────────
# validate: Hibernate checks the entities against the Flyway-managed schema and
# refuses to start if they disagree. Never `update` on a live database.
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false

# ── Secrets ────────────────────────────────────────────────────────────────
# Both generated by scripts/gen-secrets.sh. They are NOT interchangeable and
# are not rotated on the same schedule:
#
#   JWT_SECRET            — rotating it signs everyone out. 15-minute access
#                           tokens, so that is the whole cost. Rotate freely.
#   TICKET_SIGNING_SECRET — rotating it invalidates every ticket QR already in
#                           a customer's hand, including ones for events that
#                           have not happened yet. Set once, keep, back up.
JWT_SECRET=
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=1209600000
TICKET_SIGNING_SECRET=
TICKET_QR_SIZE_PX=256
TICKET_QR_MARGIN=4

# ── CORS ───────────────────────────────────────────────────────────────────
# With the default single-origin setup (Caddy serves the SPA and proxies /api
# on the same host) the browser never makes a cross-origin request and this is
# never consulted. It is set correctly anyway so that splitting the SPA onto
# its own domain later is a one-line change rather than a debugging session.
CORS_ALLOWED_ORIGINS=https://booking.example.com

# ── API docs ───────────────────────────────────────────────────────────────
# Swagger UI is a complete, annotated map of the attack surface and is worth
# nothing to a legitimate user of the deployed app. Keep it false in production;
# read the spec on a laptop instead.
APP_DOCS_PUBLIC=false

# ── Booking holds ──────────────────────────────────────────────────────────
HOLD_TTL_MINUTES=10
HOLD_EXTENSION_MINUTES=3
HOLD_SWEEPER_INTERVAL_MS=30000
BOOKING_PAYMENT_WINDOW_MINUTES=15
FX_KHR_PER_USD=4100.0000

# ── Bakong KHQR ────────────────────────────────────────────────────────────
# LIVE. MOCK generates real KHQR strings but simulates settlement and registers
# /api/v1/dev/payments/**, which marks a booking paid without money moving.
BAKONG_MODE=LIVE
BAKONG_BASE_URL=https://api-bakong.nbc.gov.kh
# Issued by NBC against a registered email. It EXPIRES — a stale token means
# every poll 401s and no booking ever confirms itself. Diarise the renewal.
BAKONG_BEARER_TOKEN=
BAKONG_ACCOUNT_ID=
BAKONG_ACCOUNT_TYPE=INDIVIDUAL
BAKONG_MERCHANT_ID=
BAKONG_ACQUIRING_BANK=
# Hard EMVCo limits of 25 and 15 characters. The app refuses to start rather
# than emit a QR that banking apps reject.
BAKONG_MERCHANT_NAME=Event Booking KH
BAKONG_MERCHANT_CITY=Phnom Penh
BAKONG_CURRENCY=KHR
BAKONG_QR_TTL=5m

# ── ABA PayWay ─────────────────────────────────────────────────────────────
# LIVE, and note this is enforced twice: MOCK alone no longer registers the
# simulation endpoints, they also require the dev profile. Set it correctly
# regardless — defence in depth is not an excuse to lean on the other layer.
PAYWAY_MODE=LIVE
PAYWAY_BASE_URL=https://checkout.payway.com.kh
# Both REQUIRED. application.yml no longer defaults the merchant id, so leaving
# either blank fails the PayWay call instead of transacting as the wrong
# merchant. Both come from the ABA merchant portal and belong only in this file.
PAYWAY_MERCHANT_ID=
PAYWAY_API_KEY=

# ── Payment reconciler and scheduling ──────────────────────────────────────
# The hold sweeper, the payment poller and the booking-expiry sweep do NOT
# coordinate across processes. Exactly ONE instance may have these on. If you
# ever scale the API to two containers, the second one sets both to false.
SCHEDULING_ENABLED=true
PAYMENT_POLL_ENABLED=true
PAYMENT_POLL_INTERVAL=5s
PAYMENT_POLL_BATCH_SIZE=50
PAYMENT_MIN_REFRESH_INTERVAL=3s
# Bakong meters per token and can cap an account at 100 requests a DAY, so the
# per-provider floor is in minutes on purpose. Lower it only if you know your
# quota is higher.
BAKONG_POLL_FLOOR=60s
PAYWAY_POLL_FLOOR=3s
BOOKING_SWEEP_INTERVAL=1m

# ── Cloudinary ─────────────────────────────────────────────────────────────
# The app refuses to start with any of these blank. Use a production-specific
# folder: sharing one with dev means a test upload can overwrite a live poster.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=event-booking/prod

# ── Connection pool ────────────────────────────────────────────────────────
# Must fit inside Postgres's max_connections (100 by default) across every
# client: the API, pg_dump from the backup job, and any psql you open. 20 is
# comfortable for one API container on a small VPS.
HIKARI_MAX_POOL_SIZE=20
HIKARI_MIN_IDLE=5

# ── Build / runtime knobs ──────────────────────────────────────────────────
# Baked into the SPA at build time, not read at runtime.
VITE_API_BASE_URL=/api/v1
VITE_APP_NAME=Event Booking Cambodia
VITE_DEFAULT_CURRENCY=USD
# Container memory ceiling for the JVM. The heap is 75% of this (see the
# Dockerfile's MaxRAMPercentage), the rest is metaspace, threads and code cache.
API_MEM_LIMIT=1500m
# Tag applied to the images this stack builds. Leave as latest unless you are
# building elsewhere and pushing to a registry.
IMAGE_TAG=latest

# ── Monitoring overlay (optional) ──────────────────────────────────────────
# Only read when you start docker-compose.monitoring.yml alongside the main
# stack. Every one of these ports binds to 127.0.0.1 and Caddy does not route to
# any of them — reach Grafana with `ssh -L 3000:localhost:53000 you@your-vps`.
# Set GRAFANA_PASSWORD before starting it; the container's fallback is `admin`.
GRAFANA_USER=admin
GRAFANA_PASSWORD=
GRAFANA_PORT=53000
PROMETHEUS_PORT=59090
LOKI_PORT=53100
