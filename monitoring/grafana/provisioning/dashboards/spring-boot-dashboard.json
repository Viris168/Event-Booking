{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "8.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "datasource", "id": "loki", "name": "Loki", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "Spring Boot 3 / Micrometer metrics — HTTP, JVM, HikariCP, business counters + Loki logs",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    {
      "id": 1,
      "type": "row",
      "title": "🌐 HTTP",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },

    {
      "id": 2,
      "title": "HTTP Request Rate (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "reqps"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"event-booking-api\"}[1m])) by (uri, method, status)",
          "legendFormat": "{{method}} {{uri}} [{{status}}]",
          "refId": "A"
        }
      ],
      "options": { "tooltip": { "mode": "multi" } }
    },

    {
      "id": 3,
      "title": "HTTP Response Time — p50 / p95 / p99",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_server_requests_seconds_bucket{application=\"event-booking-api\"}[1m])) by (le, uri))",
          "legendFormat": "p50 {{uri}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{application=\"event-booking-api\"}[1m])) by (le, uri))",
          "legendFormat": "p95 {{uri}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{application=\"event-booking-api\"}[1m])) by (le, uri))",
          "legendFormat": "p99 {{uri}}",
          "refId": "C"
        }
      ]
    },

    {
      "id": 4,
      "title": "HTTP Error Rate (4xx + 5xx)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "reqps"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"event-booking-api\", status=~\"4..\"}[1m])) by (uri, status)",
          "legendFormat": "4xx {{uri}} [{{status}}]",
          "refId": "A"
        },
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"event-booking-api\", status=~\"5..\"}[1m])) by (uri, status)",
          "legendFormat": "5xx {{uri}} [{{status}}]",
          "refId": "B"
        }
      ]
    },

    {
      "id": 5,
      "title": "Total Requests (last 5m)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 9 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "green", "value": 0 }] },
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "sum(increase(http_server_requests_seconds_count{application=\"event-booking-api\"}[5m]))",
          "legendFormat": "Requests",
          "refId": "A"
        }
      ]
    },

    {
      "id": 6,
      "title": "Error % (last 5m)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 9 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          },
          "unit": "percent"
        }
      },
      "targets": [
        {
          "expr": "100 * sum(rate(http_server_requests_seconds_count{application=\"event-booking-api\", status=~\"[45]..\"}[5m])) / sum(rate(http_server_requests_seconds_count{application=\"event-booking-api\"}[5m]))",
          "legendFormat": "Error %",
          "refId": "A"
        }
      ]
    },

    {
      "id": 7,
      "title": "Apdex Score",
      "description": "Apdex = (Satisfied + Tolerating/2) / Total. Satisfied < 0.5s, Tolerating < 2s.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 9 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "yellow", "value": 0.7 },
              { "color": "green", "value": 0.9 }
            ]
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 2
        }
      },
      "targets": [
        {
          "expr": "(sum(rate(http_server_requests_seconds_bucket{application=\"event-booking-api\",le=\"0.5\"}[5m])) + sum(rate(http_server_requests_seconds_bucket{application=\"event-booking-api\",le=\"2\"}[5m])) - sum(rate(http_server_requests_seconds_bucket{application=\"event-booking-api\",le=\"0.5\"}[5m]))) / 2 / sum(rate(http_server_requests_seconds_count{application=\"event-booking-api\"}[5m]))",
          "legendFormat": "Apdex",
          "refId": "A"
        }
      ]
    },

    {
      "id": 8,
      "title": "Top 5 Slowest Endpoints (p95, last 5m)",
      "type": "table",
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 13 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "uri" },
            "properties": [{ "id": "custom.width", "value": 300 }]
          }
        ]
      },
      "options": {
        "sortBy": [{ "displayName": "Value", "desc": true }],
        "footer": { "show": false }
      },
      "transformations": [
        { "id": "sortBy", "options": { "fields": [{ "displayName": "Value", "desc": true }] } },
        { "id": "limit", "options": { "limitCount": 5 } }
      ],
      "targets": [
        {
          "expr": "topk(5, histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{application=\"event-booking-api\"}[5m])) by (le, uri)))",
          "legendFormat": "{{uri}}",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ]
    },

    {
      "id": 10,
      "type": "row",
      "title": "☕ JVM",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "collapsed": false
    },

    {
      "id": 11,
      "title": "JVM Heap Memory",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "bytes"
        }
      },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{application=\"event-booking-api\", area=\"heap\"}",
          "legendFormat": "Used ({{id}})",
          "refId": "A"
        },
        {
          "expr": "jvm_memory_committed_bytes{application=\"event-booking-api\", area=\"heap\"}",
          "legendFormat": "Committed ({{id}})",
          "refId": "B"
        },
        {
          "expr": "jvm_memory_max_bytes{application=\"event-booking-api\", area=\"heap\"}",
          "legendFormat": "Max ({{id}})",
          "refId": "C"
        }
      ]
    },

    {
      "id": 12,
      "title": "JVM Non-Heap Memory",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "bytes"
        }
      },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{application=\"event-booking-api\", area=\"nonheap\"}",
          "legendFormat": "Used ({{id}})",
          "refId": "A"
        },
        {
          "expr": "jvm_memory_committed_bytes{application=\"event-booking-api\", area=\"nonheap\"}",
          "legendFormat": "Committed ({{id}})",
          "refId": "B"
        }
      ]
    },

    {
      "id": 13,
      "title": "JVM GC Pause Duration",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 26 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "rate(jvm_gc_pause_seconds_sum{application=\"event-booking-api\"}[1m])",
          "legendFormat": "GC Pause — {{action}} ({{cause}})",
          "refId": "A"
        }
      ]
    },

    {
      "id": 14,
      "title": "JVM Threads",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 26 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "jvm_threads_live_threads{application=\"event-booking-api\"}",
          "legendFormat": "Live",
          "refId": "A"
        },
        {
          "expr": "jvm_threads_peak_threads{application=\"event-booking-api\"}",
          "legendFormat": "Peak",
          "refId": "B"
        },
        {
          "expr": "jvm_threads_daemon_threads{application=\"event-booking-api\"}",
          "legendFormat": "Daemon",
          "refId": "C"
        }
      ]
    },

    {
      "id": 15,
      "title": "CPU Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 26 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      },
      "targets": [
        {
          "expr": "process_cpu_usage{application=\"event-booking-api\"}",
          "legendFormat": "Process CPU",
          "refId": "A"
        },
        {
          "expr": "system_cpu_usage{application=\"event-booking-api\"}",
          "legendFormat": "System CPU",
          "refId": "B"
        }
      ]
    },

    {
      "id": 20,
      "type": "row",
      "title": "🗄️ HikariCP — Database Connection Pool",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 },
      "collapsed": false
    },

    {
      "id": 21,
      "title": "HikariCP Active / Idle / Pending",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 35 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "hikaricp_connections_active{application=\"event-booking-api\"}",
          "legendFormat": "Active",
          "refId": "A"
        },
        {
          "expr": "hikaricp_connections_idle{application=\"event-booking-api\"}",
          "legendFormat": "Idle",
          "refId": "B"
        },
        {
          "expr": "hikaricp_connections_pending{application=\"event-booking-api\"}",
          "legendFormat": "Pending (waiting for connection)",
          "refId": "C"
        }
      ]
    },

    {
      "id": 22,
      "title": "HikariCP Connection Acquisition Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 35 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(hikaricp_connections_acquire_seconds_bucket{application=\"event-booking-api\"}[1m])) by (le, pool))",
          "legendFormat": "p95 acquire — {{pool}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(hikaricp_connections_acquire_seconds_bucket{application=\"event-booking-api\"}[1m])) by (le, pool))",
          "legendFormat": "p99 acquire — {{pool}}",
          "refId": "B"
        }
      ]
    },

    {
      "id": 23,
      "title": "HikariCP Pool Size",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 43 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "blue", "value": 0 }] },
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "hikaricp_connections{application=\"event-booking-api\"}",
          "legendFormat": "Pool Size",
          "refId": "A"
        }
      ]
    },

    {
      "id": 24,
      "title": "HikariCP Timeouts",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 43 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "sum(increase(hikaricp_connections_timeout_total{application=\"event-booking-api\"}[5m]))",
          "legendFormat": "Timeouts (5m)",
          "refId": "A"
        }
      ]
    },

    {
      "id": 25,
      "title": "Connection Pool Usage %",
      "description": "Active connections as a percentage of total pool size.",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 43 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 60 },
              { "color": "red", "value": 85 }
            ]
          },
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      },
      "options": { "reduceOptions": { "calcs": ["last"] }, "showThresholdLabels": false, "showThresholdMarkers": true },
      "targets": [
        {
          "expr": "100 * hikaricp_connections_active{application=\"event-booking-api\"} / hikaricp_connections{application=\"event-booking-api\"}",
          "legendFormat": "Usage %",
          "refId": "A"
        }
      ]
    },

    {
      "id": 30,
      "type": "row",
      "title": "💳 Business Metrics",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 47 },
      "collapsed": false
    },

    {
      "id": 31,
      "title": "Payment Poll Duration (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 48 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(payment_poll_duration_seconds_bucket{application=\"event-booking-api\"}[1m])) by (le))",
          "legendFormat": "p95 poll duration",
          "refId": "A"
        }
      ]
    },

    {
      "id": 32,
      "title": "Hold Expiry Job Duration",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 48 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(hold_expiry_duration_seconds_bucket{application=\"event-booking-api\"}[1m])) by (le))",
          "legendFormat": "p95 hold expiry duration",
          "refId": "A"
        }
      ]
    },

    {
      "id": 40,
      "type": "row",
      "title": "📋 Logs (Loki)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 56 },
      "collapsed": false
    },

    {
      "id": 41,
      "title": "Application Logs — INFO & above",
      "type": "logs",
      "gridPos": { "h": 12, "w": 16, "x": 0, "y": 57 },
      "datasource": "Loki",
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "{application=\"event-booking-api\"} |= ``",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },

    {
      "id": 42,
      "title": "Errors & Warnings Only",
      "type": "logs",
      "gridPos": { "h": 12, "w": 8, "x": 16, "y": 57 },
      "datasource": "Loki",
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "{application=\"event-booking-api\", level=~\"ERROR|WARN\"}",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },

    {
      "id": 43,
      "title": "Log Rate by Level",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 69 },
      "datasource": "Loki",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 15 },
          "unit": "short"
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "ERROR" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "WARN" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "INFO" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] }
        ]
      },
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "sum(rate({application=\"event-booking-api\", level=\"ERROR\"}[1m]))",
          "legendFormat": "ERROR",
          "refId": "A"
        },
        {
          "expr": "sum(rate({application=\"event-booking-api\", level=\"WARN\"}[1m]))",
          "legendFormat": "WARN",
          "refId": "B"
        },
        {
          "expr": "sum(rate({application=\"event-booking-api\", level=\"INFO\"}[1m]))",
          "legendFormat": "INFO",
          "refId": "C"
        }
      ]
    }

  ],
  "refresh": "15s",
  "schemaVersion": 38,
  "tags": ["spring-boot", "java", "event-booking"],
  "templating": { "list": [] },
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Event Booking API",
  "uid": "event-booking-api-v1",
  "version": 2
}
