# ── Server ─────────────────────────────────────────────
SERVER_PORT=8080

# ── Database (PostgreSQL) ──────────────────────────────
# Runs via `docker compose up -d` (see docker-compose.yml at repo root).
# Host port is 55432, not the default 5432, to avoid clashing with other
# Postgres containers in Docker Desktop.
DB_URL=jdbc:postgresql://localhost:55432/event_booking
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ── JPA / Hibernate ────────────────────────────────────
# validate = check entities against Flyway-managed tables, never modify them.
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=true

# ── JWT ────────────────────────────────────────────────
# Must be at least 32 characters. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=1209600000

# ── CORS ───────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Booking holds ──────────────────────────────────────
HOLD_TTL_MINUTES=10
HOLD_EXTENSION_MINUTES=3
HOLD_SWEEPER_INTERVAL_MS=30000

# ── Bakong KHQR ────────────────────────────────────────
# MOCK generates real, scannable KHQR strings but simulates settlement, and
# enables POST /api/dev/payments/{id}/pay. Nobody needs credentials to run the
# whole flow. LIVE talks to the real API and requires a bearer token.
BAKONG_MODE=MOCK
BAKONG_BASE_URL=https://api-bakong.nbc.gov.kh
# Issued by NBC against a registered email, at https://api-bakong.nbc.gov.kh.
# It expires; a stale token means every poll 401s and nothing ever confirms.
BAKONG_BEARER_TOKEN=
# The account the money lands in, e.g. event_booking@wing
BAKONG_ACCOUNT_ID=event_booking@dev
# INDIVIDUAL or MERCHANT. MERCHANT also needs the next two.
BAKONG_ACCOUNT_TYPE=INDIVIDUAL
BAKONG_MERCHANT_ID=
BAKONG_ACQUIRING_BANK=
# Shown in the payer's banking app. Max 25 and 15 characters - the app refuses
# to start rather than emit a QR that banks reject.
BAKONG_MERCHANT_NAME=Event Booking KH
BAKONG_MERCHANT_CITY=Phnom Penh
# USD or KHR. Both totals are snapshotted on the booking; this picks which one
# is actually charged.
BAKONG_CURRENCY=KHR
# How long a QR stays scannable. Keep it well under
# BOOKING_PAYMENT_WINDOW_MINUTES so an abandoned QR is reclaimed while the
# customer still has time to start a fresh one.
BAKONG_QR_TTL=5m

# ── Payment reconciler ─────────────────────────────────
# The loop that asks Bakong whether an outstanding QR has been paid. Turn it
# off on a second instance: the sweeps do not coordinate across processes.
PAYMENT_POLL_ENABLED=true
PAYMENT_POLL_INTERVAL=5s
PAYMENT_POLL_BATCH_SIZE=50
PAYMENT_MIN_REFRESH_INTERVAL=3s
# The sweep that expires unpaid bookings and puts their seats back on sale.
BOOKING_SWEEP_INTERVAL=1m

# ── Tickets ────────────────────────────────────────────
# Signs the QR payloads. At least 32 characters:
#   openssl rand -base64 48
# Rotating this invalidates every ticket already issued, so set it once and
# keep it — it is not the JWT secret and should not be rotated on the same
# schedule. The app warns at startup while it is still the shipped placeholder.
TICKET_SIGNING_SECRET=
TICKET_QR_SIZE_PX=256
TICKET_QR_MARGIN=4
