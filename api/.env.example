# ── Server ─────────────────────────────────────────────
SERVER_PORT=8080

# ── Database (PostgreSQL) ──────────────────────────────
# Runs via `docker compose up -d` (see docker-compose.yml at repo root).
# Host port is 55432, not the default 5432, to avoid clashing with other
# Postgres containers in Docker Desktop.
DB_URL=jdbc:postgresql://localhost:55432/event_booking
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ── JPA / Hibernate ────────────────────────────────────
# validate = check entities against Flyway-managed tables, never modify them.
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=true

# ── JWT ────────────────────────────────────────────────
# At least 32 characters, AND not the placeholder from application.yml -
# JwtSecretGuard refuses to start on that one outside the dev profile. Both
# checks exist because they answer different questions: length is "big enough to
# resist guessing", identity is "does anyone else already have it". The repo
# placeholder passed the first for months while failing the second.
#
#   openssl rand -base64 48
#
# Rotating this is cheap - access tokens last 15 minutes, so the only cost is
# that everyone signs in again. Do not confuse it with TICKET_SIGNING_SECRET,
# which is not cheap to rotate.
JWT_SECRET=
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=1209600000

# ── CORS ───────────────────────────────────────────────
# The browser origin(s) the SPA is served from. A deployment MUST set this to
# the real frontend origin - leave it on the Vite dev server and every call from
# the deployed app is blocked by the browser.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── API docs ───────────────────────────────────────────
# Swagger UI and /v3/api-docs. Off by default: the spec is a complete map of the
# attack surface, and is worth nothing to a legitimate user of the deployed app.
# Set true on a laptop or a private staging host.
APP_DOCS_PUBLIC=false

# ── Booking holds ──────────────────────────────────────
HOLD_TTL_MINUTES=10
HOLD_EXTENSION_MINUTES=3
HOLD_SWEEPER_INTERVAL_MS=30000

# ── Bakong KHQR ────────────────────────────────────────
# MOCK generates real, scannable KHQR strings but simulates settlement, and
# enables POST /api/dev/payments/{id}/pay. Nobody needs credentials to run the
# whole flow. LIVE talks to the real API and requires a bearer token.
BAKONG_MODE=MOCK
BAKONG_BASE_URL=https://api-bakong.nbc.gov.kh
# Issued by NBC against a registered email, at https://api-bakong.nbc.gov.kh.
# It expires; a stale token means every poll 401s and nothing ever confirms.
BAKONG_BEARER_TOKEN=
# The account the money lands in, e.g. event_booking@wing
BAKONG_ACCOUNT_ID=event_booking@dev
# INDIVIDUAL or MERCHANT. MERCHANT also needs the next two.
BAKONG_ACCOUNT_TYPE=INDIVIDUAL
BAKONG_MERCHANT_ID=
BAKONG_ACQUIRING_BANK=
# Shown in the payer's banking app. Max 25 and 15 characters - the app refuses
# to start rather than emit a QR that banks reject.
BAKONG_MERCHANT_NAME=Event Booking KH
BAKONG_MERCHANT_CITY=Phnom Penh
# USD or KHR. Both totals are snapshotted on the booking; this picks which one
# is actually charged.
BAKONG_CURRENCY=KHR
# How long a QR stays scannable. Keep it well under
# BOOKING_PAYMENT_WINDOW_MINUTES so an abandoned QR is reclaimed while the
# customer still has time to start a fresh one.
BAKONG_QR_TTL=5m

# ── ABA PayWay ─────────────────────────────────────────
# MOCK registers /api/v1/dev/payway/**, which marks a transaction approved
# without ABA having approved anything. It now ALSO requires the `dev` profile,
# so a deploy that forgets this variable no longer gets a free-money endpoint -
# but set it anyway.
PAYWAY_MODE=LIVE
# checkout-sandbox.payway.com.kh for testing; the production host otherwise.
PAYWAY_BASE_URL=https://checkout-sandbox.payway.com.kh
PAYWAY_MERCHANT_ID=
# Merchant credential from the ABA merchant portal. Never commit it.
PAYWAY_API_KEY=

# ── Payment reconciler ─────────────────────────────────
# The loop that asks Bakong whether an outstanding QR has been paid. Turn it
# off on a second instance: the sweeps do not coordinate across processes.
PAYMENT_POLL_ENABLED=true
PAYMENT_POLL_INTERVAL=5s
PAYMENT_POLL_BATCH_SIZE=50
PAYMENT_MIN_REFRESH_INTERVAL=3s
# The sweep that expires unpaid bookings and puts their seats back on sale.
BOOKING_SWEEP_INTERVAL=1m

# ── Tickets ────────────────────────────────────────────
# Signs the QR payloads. At least 32 characters:
#   openssl rand -base64 48
# Rotating this invalidates every ticket already issued, so set it once and
# keep it — it is not the JWT secret and should not be rotated on the same
# schedule. The app warns at startup while it is still the shipped placeholder.
TICKET_SIGNING_SECRET=
TICKET_QR_SIZE_PX=256
TICKET_QR_MARGIN=4

# ── Cloudinary ─────────────────────────────────────────
# Image hosting for events and avatars. All three are on the dashboard at
# https://console.cloudinary.com. cloud_name is public (it appears in every
# delivery URL); the key and secret are not. The app refuses to start with any
# of them blank.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# public_id prefix every upload is filed under. Use a different value per
# environment - sharing one means a dev upload can overwrite a live poster.
CLOUDINARY_FOLDER=event-booking/dev

# ── Scheduling ─────────────────────────────────────────
# The hold sweeper, the payment poller and the booking expiry sweep. They do not
# coordinate across processes, so exactly ONE instance may have this on.
SCHEDULING_ENABLED=true

# ── Logging ────────────────────────────────────────────
# Must point at the same file Promtail tails - it mounts the repo-root logs/
# directory, so a run launched from api/ needs this set explicitly or the log
# lands in api/logs and the dashboards stay empty.
LOGGING_FILE_PATH=../logs/app.log

# ── Connection pool ────────────────────────────────────
# Tune down in production to whatever the database's max_connections can afford
# across every instance, not just this one.
HIKARI_MAX_POOL_SIZE=20
HIKARI_MIN_IDLE=5
